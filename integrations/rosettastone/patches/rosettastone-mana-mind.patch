+    minion.gameTags[GameTag::CANT_BE_TARGETED_BY_OPPONENTS] = 1;
+    minion.gameTags[GameTag::CHARGE] = 1;
+    minion.gameTags[GameTag::TAUNT] = 1;
+    minion.gameTags[GameTag::REBORN] = 1;
